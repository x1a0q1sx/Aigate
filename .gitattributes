# 统一换行符为 LF，保证 Windows / macOS / Linux 协作者一致，避免 CRLF/LF 引起的无意义 diff
* text=auto eol=lf

# 二进制资源不转换、不自动识别为文本
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.sqlite binary
*.db binary
*.db-shm binary
*.db-wal binary

# ── 归档保护（git archive / git bundle / 发布打包时排除敏感与运行时文件）──
# 即使被意外加入 git 跟踪，以下文件也不会进入 Release 压缩包（release.yml 用 git archive）
config.yaml export-ignore
config.local.yaml export-ignore
config.local.* export-ignore
.env export-ignore
.env.* export-ignore
data/ export-ignore
*.db export-ignore
*.db-shm export-ignore
*.db-wal export-ignore
*.sqlite export-ignore
*.log export-ignore
*.jsonl.gz export-ignore
*.pem export-ignore
*.key export-ignore
